# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
DUALHOOK_LIVE_KEY=
# Secret path segment for the inbound webhook — Meta posts to
# https://<host>/webhook/$WEBHOOK_PATH_SECRET. Required; the app refuses to
# boot without it. Generate with: openssl rand -hex 24
WEBHOOK_PATH_SECRET=
WHATSAPP_GRAPH_VERSION=v25.0

# Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# iCal
ICAL_URL=

# Owner notifications (Phase 5)
# Both channels are optional. Notifications fan out to whichever channel(s) you set.
# WhatsApp recipient + identifies owner for /pause /release /resume /status
# SMTP recipient (optional)
OWNER_EMAIL=
OWNER_PHONE=
OWNER_WHATSAPP_TEMPLATE=owner_notification

# SMTP — only required if OWNER_EMAIL is set
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SuperControl email integration
SUPERCONTROL_IMAP_HOST=imap.gmail.com
SUPERCONTROL_IMAP_PORT=993
SUPERCONTROL_IMAP_USER=
SUPERCONTROL_IMAP_PASS=
SUPERCONTROL_IMAP_POLL_MS=30000
# Spacing between back-to-back nudge sends when one poll yields multiple
# unseen emails — avoids Meta template-API rate-limiting.
SUPERCONTROL_DISPATCH_SPACING_MS=3000

# App
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Pin the process timezone. Booking dates are UTC-midnight calendar dates;
# a non-UTC server silently shifts iCal parsing and cron schedules.
TZ=UTC

# Country code applied to national-format phone numbers ("07901857452") when
# normalising to the canonical digits-only form. Guests are UK-based.
DEFAULT_COUNTRY_CODE=44
